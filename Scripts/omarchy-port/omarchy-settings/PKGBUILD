# Repackage Omarchy's x86_64 'omarchy-settings' package for aarch64 (uConsole CM4).
#
# Like 'omarchy', this is configuration only -- no compiled code. Three things
# are removed because they would break or confuse a Raspberry Pi:
#
#   etc/mkinitcpio.conf.d/omarchy_hooks.conf
#       Replaces the initramfs HOOKS with Omarchy's PC set (plymouth, encrypt,
#       btrfs-overlayfs). btrfs-overlayfs comes from limine-snapper-sync, which
#       is not installed here, so every kernel update would fail to build an
#       initramfs -- and the uConsole would not boot the next time.
#   etc/mkinitcpio.conf.d/thunderbolt_module.conf
#       There is no Thunderbolt on a CM4; mkinitcpio errors on the missing module.
#   etc/limine-entry-tool.d/
#       Limine bootloader settings; a Pi does not use Limine.
#
# And the install script's "keep Arch Linux ARM's system identity" branch,
# which upstream applies to Apple Silicon only, is widened to every aarch64
# machine. That is the branch written for an Arch Linux ARM base, which is
# exactly what the uConsole runs.
#
# Upstream: https://github.com/basecamp/omarchy (MIT)

pkgname=omarchy-settings
pkgver=4.0.4
_uprel=1
pkgrel=1
pkgdesc="Omarchy system settings (uConsole aarch64 repackage)"
arch=(aarch64)
url="https://github.com/basecamp/omarchy"
license=(MIT)
depends=(bash curl gum hicolor-icon-theme plymouth)
options=(!strip !debug)
install=omarchy-settings.install
source=("https://pkgs.omarchy.org/stable/x86_64/${pkgname}-${pkgver}-${_uprel}-x86_64.pkg.tar.zst")
noextract=("${pkgname}-${pkgver}-${_uprel}-x86_64.pkg.tar.zst")
sha256sums=('748c2ee7edc3c67f8c09bdfa9f0930837684297c7107b8a3a87540f8dfe1d100')

# omarchy-settings.install is upstream's .INSTALL with the Apple Silicon check
# widened. build-packages.sh generates it from the upstream package before
# makepkg runs -- makepkg requires the install file to exist up front, so it
# cannot be produced from prepare().

# Fail if the package contains any ELF binary. file(1) is run without its
# seccomp sandbox (-S): under fakeroot in a container that sandbox gets file
# killed, and a guard that cannot look must fail rather than pass.
_no_elf_binaries() {
  local types
  types="$(find "${pkgdir}" -type f -exec file -S -b {} +)" || {
    echo "ERROR: could not inspect the package contents with file(1)." >&2
    return 1
  }
  if grep -q 'ELF' <<<"${types}"; then
    echo "ERROR: upstream package now contains ELF binaries; it cannot be repackaged as-is." >&2
    return 1
  fi
}

package() {
  bsdtar -xpf "${srcdir}/${pkgname}-${pkgver}-${_uprel}-x86_64.pkg.tar.zst" -C "${pkgdir}" \
    --exclude .PKGINFO --exclude .BUILDINFO --exclude .MTREE --exclude .INSTALL

  rm -f  "${pkgdir}/etc/mkinitcpio.conf.d/omarchy_hooks.conf"
  rm -f  "${pkgdir}/etc/mkinitcpio.conf.d/thunderbolt_module.conf"
  rmdir  "${pkgdir}/etc/mkinitcpio.conf.d" 2>/dev/null || true
  rm -rf "${pkgdir}/etc/limine-entry-tool.d"

  _no_elf_binaries
}
